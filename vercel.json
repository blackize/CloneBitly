{
    "installCommand": "npm install",
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        },
        {
            "src": "backend/src/vercel.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "backend/prisma/schema.prisma"
                ],
                "runtime": "nodejs20.x",
                "memory": 1024,
                "maxDuration": 30
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/src/vercel.ts",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/api",
            "dest": "backend/src/vercel.ts"
        },
        {
            "src": "/favicon.ico",
            "dest": "frontend/favicon.ico"
        },
        {
            "src": "/favicon.png",
            "dest": "frontend/favicon.png"
        },
        {
            "src": "/robots.txt",
            "dest": "frontend/robots.txt"
        },
        {
            "src": "/sitemap.xml",
            "dest": "frontend/sitemap.xml"
        },
        {
            "src": "/stats/(.*)",
            "dest": "frontend/stats/$1"
        },
        {
            "src": "/stats",
            "dest": "frontend/stats"
        },
        {
            "src": "/((?!api|stats|favicon|robots|sitemap|.*\\.ico|.*\\.png|.*\\.txt|.*\\.xml)[^/]{1,20})",
            "dest": "backend/src/vercel.ts"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/$1"
        }
    ]
}