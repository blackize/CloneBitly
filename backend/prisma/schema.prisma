generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model ShortLink {
  id              String       @id @default(uuid())
  originalUrl     String
  slug            String       @unique
  createdAt       DateTime     @default(now())
  clickCount      Int          @default(0)

  @@index([slug])
  @@map("short_links")
}


